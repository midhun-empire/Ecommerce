.stock-info {
    font-size: 12px;
    color: #28a745;
    margin-left: 4px;
}

#selectedStockInfo {
    font-size: 14px;
    font-weight: 500;
    padding: 8px;
    border-radius: 4px;
    background-color: #f8f9fa;
}
.rating-input {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
}

.rating-input input {
    display: none;
}

.rating-input label {
    cursor: pointer;
    width: 25px;
    font-size: 25px;
    color: #ddd;
}

.rating-input label:before {
    content: '\f005';
    font-family: 'Font Awesome 5 Free';
    font-weight: 900;
}

.rating-input input:checked ~ label,
.rating-input label:hover,
.rating-input label:hover ~ label {
    color: #ffd700;
}
.review-card {
    background-color: #fff;
    transition: transform 0.2s;
}

.review-card:hover {
