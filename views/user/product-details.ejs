            <div class="banner-content">
                <h1>Our Collection</h1>
                <p>Discover our curated selection of premium products</p>
            </div>
        </div>

        <div class="breadcrumb">
            <a href="/">Home &nbsp; </a>
            <span> / </span>
            <a href="/shop">&nbsp; Shop</a>
        </div>
    
        <div class="main-content">
            <div class="row">
                <div class="col-md-6">
                    <div class="product-gallery">
