    <style>
            :root {
            --primary-color: #3a3a3a;
            --secondary-color: #088178;
            --light-gray: #f8f8f8;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            color: var(--primary-color);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }


        .breadcrumb-wrap {
            background: var(--light-gray);
            padding: 15px 0;
            margin-bottom: 50px;
        }

        .breadcrumb {
            margin: 0;
            padding: 0;
            font-size: 14px;
        }

        .breadcrumb a {
            color: var(--primary-color);
            text-decoration: none;
        }

        .breadcrumb span {
            margin: 0 10px;
            color: #666;
        }
        .product-details-banner {
            background: linear-gradient(rgba(8, 129, 120, 0.9), rgba(8, 129, 120, 0.8));
            padding: 40px 0;
            width: 100vw;
            position: relative;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
            margin-bottom: 40px;
        }

        .banner-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }

       /* Breadcrumb Container */
.breadcrumb {
    font-family: Arial, sans-serif;
    font-size: 14px;
    color: #333;
    margin: 10px 0;
}

/* Breadcrumb Links */
.breadcrumb a {
    text-decoration: none;
    color: #15181b;
}

.breadcrumb a:hover {
    text-decoration: underline;
    color: #005bb5;
}

/* Breadcrumb Separator */
.breadcrumb .separator {
    margin: 0 5px;
    color: #999;
}

/* Current Page (Non-clickable) */
.breadcrumb .current {
    color: #666;
    font-weight: bold;
}



  

  /* Container Fixes */
  .main-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }

     /* Full Width Footer Styles */
     footer {
            background: #f8f9fa;
            margin-top: 60px;
            padding: 40px 0;
            width: 100vw;
            position: relative;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }

    /* Responsive Fixes */
    @media (max-width: 768px) {
        .product-details-banner {
            padding: 20px 0;
        }

        .banner-content {
            padding: 0 10px;
        }

        .main-content {
            padding: 0 10px;
        }

        .footer-content {
            padding: 0 10px;
        }
    }
/* Banner Container */
.product-details-banner {
    background: linear-gradient(rgba(17, 18, 18, 0.9), rgba(8, 129, 120, 0.8)), 
                url('/api/placeholder/1200/300') center/cover; /* Add a background image if needed */
    padding: 40px 1px;
    margin-bottom: 40px;
    position: relative;
    text-align: center;
    color: #ffffff;
}

/* Banner Content */
.banner-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
}

/* Banner Title */
.banner-content h1 {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Banner Subtitle */
.banner-content p {
    font-size: 18px;
    max-width: 600px;
    margin: 0 auto;
    opacity: 0.9;
}

/* Breadcrumb Styles */
.product-details-banner .breadcrumb {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: #ffffff;
    justify-content: center; /* Center breadcrumb */
}

.product-details-banner .breadcrumb a {
    color: #ffffff;
    text-decoration: none;
    opacity: 0.9;
    transition: opacity 0.3s;
}

.product-details-banner .breadcrumb a:hover {
    opacity: 1;
}

.product-details-banner .breadcrumb span {
    margin: 0 10px;
    color: rgba(255, 255, 255, 0.7);
}

/* Responsive Adjustments */
@media (max-width: 768px) {
    .product-details-banner {
        padding: 50px 0;
    }

    .banner-content h1 {
        font-size: 32px;
    }

    .banner-content p {
        font-size: 16px;
        padding: 0 20px;
    }

    .product-details-banner .breadcrumb {
        font-size: 13px;
    }
}


        /* Enhanced Product Gallery */
        .product-gallery {
            position: relative;
            margin-bottom: 30px;
        }


        .product-image-container {
            position: relative;
            overflow: hidden;
            border-radius: 10px;
            cursor: zoom-in;
            background-color: #fff;
            border: 1px solid #eee;
        }

        .product-image-slider img {
            width: 100%;
            height: 500px;
            border-radius: 10px;
            object-fit: contain;
            transition: transform 0.3s ease;
        }

        .product-image-container:hover .product-image-slider img {
            transform: scale(1.5);
        }

        /* Enhanced Thumbnail Navigation */
        .slider-nav-thumbnails {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;
            margin-top: 20px;
        }

        .slider-nav-thumbnails img {
            width: 100%;
            height: 80px;
            object-fit: cover;
            border-radius: 5px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s ease;
            opacity: 0.7;
        }

        .slider-nav-thumbnails img:hover {
            border-color: var(--secondary-color);
            opacity: 1;
        }

        .slider-nav-thumbnails img.active {
            border-color: var(--secondary-color);
            opacity: 1;
        }

     /* Main Container for Product Details */
.product-detail {
    padding: 20px;
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

/* Product Title */
.product-title {
    font-size: 26px;  /* Slightly smaller font size */
    font-weight: 600;
    color: var(--primary-color);
    margin-bottom: 15px;
    line-height: 1.3;
}

/* Product Meta (Rating) */
.product-meta {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;  /* Reduced margin */
}

.product-rating {
    display: flex;
    align-items: center;
    gap: 5px;
}

.product-rating i {
    color: #ffd700;
}

.product-rating span {
    color: #666;
    font-size: 14px;
}

/* Price Section */
.product-price {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;  /* Reduced margin */
}

.current-price {
    font-size: 28px;
    font-weight: 600;
    color: var(--secondary-color);
}

.old-price {
    text-decoration: line-through;
    color: #888;
    font-size: 20px;
}

.save-price {
    background-color: #ff4949;
    color: white;
    padding: 5px 15px;
    font-weight: 500;
    border-radius: 4px;
    font-size: 14px;
}

/* Product Description */
.product-description {
    margin-bottom: 20px;  /* Reduced margin */
}

.product-description h4 {
    font-size: 18px;
    font-weight: 600;
    color: var(--primary-color);
    margin-bottom: 10px;
}

.product-description p {
    color: #666;
    font-size: 16px;
    line-height: 1.6;
}

/* Product Features (Info) */
.product-info {
    background: #f8f8f8;
    padding: 15px;  /* Slightly reduced padding */
    border-radius: 8px;
    margin-bottom: 20px;  /* Reduced margin */
}

.product-info ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.product-info li {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;  /* Reduced margin */
    font-size: 14px;
    color: #666;
}

.product-info i {
    color: var(--secondary-color);
    font-size: 16px;
}

/* Product Quantity and Cart Button */
.detail-extralink {
    display: flex;
    gap: 15px;  /* Adjusted gap */
    flex-direction: row;  /* Changed to row */
    align-items: center;
}

.detail-qty {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid #e5e5e5;
    border-radius: 5px;
    padding: 5px 10px;
    background-color: #fff;
    font-size: 18px;  /* Increased font size for better visibility */
}

.detail-qty a {
    font-size: 20px;
    color: var(--primary-color);
    cursor: pointer;
}

.qty-val {
    font-size: 18px;
    font-weight: 500;
    color: #333;
}

/* Add to Cart Button */
.button-add-to-cart {
    background-color: var(--secondary-color);
    color: white;
    font-size: 16px;
    padding: 12px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: background-color 0.3s;
}

.button-add-to-cart:hover {
    background-color: #066c64;
}

/* Wishlist Button (Moved to the Right) */
.product-extra-link2 {
    display: flex;
    align-items: center;
    gap: 15px;  /* Ensures space between the cart button and wishlist icon */
}

.action-btn {
    width: 45px;
    height: 45px;
    background-color: #fff;
    border-radius: 50%;
    border: 1px solid #e5e5e5;
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s;
}

.action-btn:hover {
    background-color: var(--secondary-color);
    color: white;
    border-color: var(--secondary-color);
}

/* Product Stock Status */
.product-detail-meta {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #eee;
}

.product-detail-meta ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.product-detail-meta li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #666;
}

.meta-label {
    font-weight: 600;
    color: var(--primary-color);
}

.stock-status {
    display: flex;
    align-items: center;
    gap: 5px;
}

.stock-status.in-stock {
    color: #22c55e;
}

.stock-status.out-of-stock {
    color: #ef4444;
}

/* Category Tags */
.tag-list a {
    background-color: #f5f5f5;
    color: #666;
    padding: 5px 15px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 14px;
    transition: background-color 0.3s;
}

.tag-list a:hover {
    background-color: var(--secondary-color);
    color: white;
}

.color-selection {
    margin: 20px 0;
}

.color-options {
    display: flex;
    gap: 10px;
    margin-top: 10px;
}

.color-option {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.2s;
}

.color-option:hover {
    transform: scale(1.1);
}

.color-option.selected {
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #000;
}
/* size */
.size-selection {
    margin: 25px 0;
}

.size-selection h4 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 15px;
    color: #333;
}

.size-options {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.size-option {
    width: 50px;
    height: 50px;
    border: 2px solid #e5e5e5;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 15px;
    color: #333;
    background: white;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.size-option:hover {
    border-color: #088178;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(8, 129, 120, 0.15);
}

.size-option.selected {
    background-color: #088178;
    color: white;
    border-color: #088178;
}

.size-option.out-of-stock {
    cursor: not-allowed;
    opacity: 0.5;
    background: #f8f8f8;
    position: relative;
}

.size-option.out-of-stock::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #ccc;
    transform: rotate(-45deg);
}

/* Size Guide Button */
.size-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

      /* Enhanced Reviews Section Styles */
      .reviews-section {
            margin-top: 50px;
            padding-top: 30px;
            border-top: 1px solid #eee;
        }

        .reviews-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .reviews-summary {
            background-color: #f8f8f8;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .overall-rating {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .rating-number {
            font-size: 48px;
            font-weight: bold;
            color: var(--primary-color);
        }

        .rating-stars {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .total-reviews {
            color: #666;
            font-size: 14px;
        }

        .write-review-btn {
            background-color: var(--secondary-color);
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
            font-weight: 500;
        }

        .write-review-btn:hover {
            background-color: #066c64;
        }

        .write-review-btn i {
            margin-right: 8px;
        }

        .review-card {
            background-color: #f8f8f8;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            transition: transform 0.2s;
        }

        .review-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        .bottom-review-section {
            text-align: center;
            margin: 40px 0;
            padding: 30px;
            background-color: #f8f8f8;
            border-radius: 10px;
        }

        .bottom-review-content {
            max-width: 600px;
            margin: 0 auto;
        }

        .bottom-review-content h3 {
            color: var(--primary-color);
            margin-bottom: 15px;
            font-size: 24px;
        }

        .bottom-review-content p {
            color: #666;
            margin-bottom: 25px;
            font-size: 16px;
            line-height: 1.6;
        }

        .large-review-btn {
            background-color: var(--secondary-color);
            color: white;
            padding: 15px 40px;
            border: none;
            border-radius: 5px;
            font-size: 18px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .large-review-btn:hover {
            background-color: #066c64;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .review-filters {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background-color: white;
            border: 1px solid #ddd;
            padding: 8px 15px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 14px;
        }

        .filter-btn:hover, .filter-btn.active {
            background-color: var(--secondary-color);
            color: white;
            border-color: var(--secondary-color);
        }

        .section-title{
            display: flex;
             align-items: center;
             justify-content: center;
             margin-top: 60px;
        }
        
        

        /* also bought style */
