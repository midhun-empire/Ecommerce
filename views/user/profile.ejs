<% function getOrderStatus(orderedItems) {
  if (!orderedItems || orderedItems.length === 0) {
    return 'Unknown';
  }
  const statusOrder = ['pending', 'processing', 'shipped', 'out_for_delivery', 'delivered', 'cancelled', 'failed', 'return requested', 'returned'];
  const statuses = orderedItems.map(item => (item.status || 'Pending').toLowerCase());

  // Check if any item is return requested
  if (statuses.includes('return requested')) {
    return 'Return Requested';
  }

  // Check if any item is returned
  if (statuses.includes('returned')) {
    return 'Returned';
  }

  // If all items are cancelled, return Cancelled
  if (statuses.every(status => status === 'cancelled')) {
    return 'Cancelled';
  }

  // Find the highest-priority status excluding cancelled
  let maxIndex = -1;
  let maxStatus = 'pending';
  statuses.forEach(status => {
    if (status !== 'cancelled') {
      const index = statusOrder.indexOf(status);
      if (index > maxIndex) {
        maxIndex = index;
        maxStatus = status;
      }
    }
  });

  // Convert status to display format
  return maxStatus
    .split('_')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
} %>
