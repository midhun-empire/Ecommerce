<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.12.4/sweetalert2.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.12.4/sweetalert2.all.min.js"></script>

<script>

  
document.addEventListener("DOMContentLoaded", function() {
  const hash = window.location.hash;
  if (hash) {
    const tabTrigger = document.querySelector(`[href="${hash}"]`);
    if (tabTrigger) {
      const tab = new bootstrap.Tab(tabTrigger);
      tab.show();
    }
  }

  const paginationLinks = document.querySelectorAll('#pagination .page-link');
  paginationLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const page = this.getAttribute('data-page');
      window.location.href = `/profile?orderPage=${page}#orders`;
    });
  });

  initializeWalletTab();
  fetchWalletDetails();
  initializeWalletHistoryPagination();
});

function initializeWalletHistoryPagination() {
  const paginationLinks = document.querySelectorAll('#walletHistoryPagination .page-link');
  paginationLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const page = this.getAttribute('data-page');
      window.location.href = `/profile?walletPage=${page}#wallet-history`;
    });
  });
}

function fetchWalletDetails() {
  fetch('/walletDetails')
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        document.getElementById('walletBalance').textContent = data.balance.toFixed(2);
      } else {
        Swal.fire({
          title: 'Error!',
          text: data.message || 'Failed to fetch wallet details',
          icon: 'error',
          confirmButtonText: 'OK'
        });
      }
    })
    .catch(error => {
      console.error('Error fetching wallet details:', error);
      Swal.fire({
        title: 'Error!',
        text: 'An error occurred while fetching wallet details',
        icon: 'error',
        confirmButtonText: 'OK'
      });
    });
}

function initializeWalletTab() {
  const addMoneyButton = document.getElementById('addMoneyButton');
  if (addMoneyButton) {
    addMoneyButton.addEventListener('click', async function() {
      try {
        const amountInput = document.getElementById('walletAmount');
        const amount = parseFloat(amountInput.value);

        if (!amount || amount <= 0) {
          Swal.fire({
            title: 'Error!',
            text: 'Please enter a valid amount',
            icon: 'error',
            confirmButtonText: 'OK'
          });
          return;
        }

        const response = await fetch('/addMoney', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount })
        });

        const data = await response.json();

        if (!data.success) {
          Swal.fire({
            title: 'Error!',
            text: data.message || 'Failed to initiate payment',
            icon: 'error',
            confirmButtonText: 'OK'
          });
          return;
        }

        const options = {
          key: data.key,
          amount: data.order.amount,
          currency: data.order.currency,
          name: 'Your Company Name',
          description: 'Add Money to Wallet',
          order_id: data.order.id,
          handler: async function(response) {
            try {
              const verifyResponse = await fetch('/verifyPayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_signature: response.razorpay_signature,
                  amount: amount
                })
              });

              const verifyData = await verifyResponse.json();

              if (verifyData.success) {
                // Show success message
                await Swal.fire({
                  title: 'Success!',
                  text: 'Money added to wallet successfully!',
                  icon: 'success',
                  confirmButtonText: 'OK'
                });

                // Update wallet balance via AJAX
                const walletResponse = await fetch('/walletDetails');
                const walletData = await walletResponse.json();
                if (walletData.success) {
                  document.getElementById('walletBalance').textContent = walletData.balance.toFixed(2);
                } else {
                  console.error('Failed to update wallet balance:', walletData.message);
                }

                // Switch to Wallet Status tab
                const tabTrigger = document.querySelector('[href="#track-orders"]');
                if (tabTrigger) {
                  const tab = new bootstrap.Tab(tabTrigger);
                  tab.show();
                }

                // Reset the input field
                amountInput.value = '';
              } else {
                Swal.fire({
                  title: 'Error!',
                  text: verifyData.message || 'Payment verification failed',
                  icon: 'error',
                  confirmButtonText: 'OK'
                });
              }
            } catch (error) {
              console.error('Error in payment verification:', error);
              Swal.fire({
                title: 'Error!',
                text: 'An error occurred during payment verification',
                icon: 'error',
                confirmButtonText: 'OK'
              });
            }
          },
          prefill: {
            name: '<%= user.name %>',
            email: '<%= user.email %>',
            contact: '<%= user.phone %>'
          },
          theme: { color: '#487379' },
          modal: {
            ondismiss: function() {
              Swal.fire({
                title: 'Payment Cancelled',
                text: 'The payment process was cancelled',
                icon: 'info',
                confirmButtonText: 'OK'
              });
            }
          }
        };

        const rzp = new Razorpay(options);
        rzp.open();

        rzp.on('payment.failed', function() {
          Swal.fire({
            title: 'Payment Failed',
            text: 'Payment failed. Please try again.',
            icon: 'error',
            confirmButtonText: 'OK'
          });
        });
      } catch (error) {
        console.error('Error in wallet payment:', error);
        Swal.fire({
          title: 'Error!',
          text: 'An error occurred while processing payment',
          icon: 'error',
          confirmButtonText: 'OK'
        });
      }
    });
  }
}

function softLogout() {
  fetch('/logout')
    .then(res => {
      if (!res.ok) throw new Error('Logout request failed');
      return res.json();
    })
    .then(data => {
      if (data.success) {
        Swal.fire({
          title: 'Success!',
          text: 'Successfully Logged Out!',
          icon: 'success',
          confirmButtonText: 'OK'
        }).then(() => {
          window.location.href = '/';
        });
      } else {
        Swal.fire({
          title: 'Error!',
          text: 'Logout failed: ' + (data.message || 'Unknown error'),
          icon: 'error',
          confirmButtonText: 'OK'
        });
      }
    })
    .catch(error => {
      console.error('Error during logout:', error);
      Swal.fire({
        title: 'Error!',
        text: 'An error occurred during logout: ' + error.message,
        icon: 'error',
        confirmButtonText: 'OK'
      });
    });
}

function confirmDeleteAddress(addressId) {
  Swal.fire({
    title: 'Are you sure?',
    text: 'Do you really want to delete this address?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Yes, delete it!'
  }).then(result => {
    if (result.isConfirmed) {
      fetch(`/deleteAddress?id=${addressId}`, { method: 'GET' })
        .then(res => {
          if (!res.ok) throw new Error('Failed to delete');
          return res.text();
        })
        .then(() => {
          Swal.fire('Deleted!', 'Your address has been deleted.', 'success').then(() => {
            window.location.reload();
          });
        })
        .catch(error => {
          console.error('Deletion error:', error);
          Swal.fire('Error!', 'There was a problem deleting the address.', 'error');
        });
    }
  });
}
</script>

