<%- include("../../views/partials/user/header") %>
<style>
.required {
    color: red;
}
  .breadcrumb a {
            color: #088178;
            text-decoration: none;
        }

        .breadcrumb span {
            margin: 0 10px;
            color: #666;
        }

</style>



<div class="container mt-4">
   <h3 class="mt-3" style="color: #046963; margin-bottom:70px">Create User Address</h3>
   <h3 class="mt-3" style="color: #046963; margin-bottom:70px">Create User Address</h3>
    <div class="breadcrumb mb-4">
            <a href="/">Home</a>
            <span>/</span>
            <a href="/profile">profile</a>
    
        </div>
   <form id="addressForm" method="POST" action="/addAddress" class="border-0 p-3">
       <div class="row mb-50"> 
           <div class="form-group col-md-4">
               <label for="addressType">Address Type:<span class="required">*</span></label>
               <select class="form-control border-3" id="addressType" name="addressType" required>
                   <option value="" disabled selected>Select Address Type</option>
                   <option value="Home">Home</option>
                   <option value="Work">Work</option>
                   <option value="Office">Office</option>
               </select>
           </div>
           <div class="form-group col-md-4">
               <label for="name">Name:</label>
               <input type="text" class="form-control border-3" id="name" name="name" required>
           </div>
           <div class="form-group col-md-4">
               <label for="city">City:</label>
               <input type="text" class="form-control border-3" id="city" name="city" required>
           </div>
       </div>
       <div class="row mb-3">
           <div class="form-group col-md-4">
               <label for="landMark">Landmark:</label>
               <input type="text" class="form-control border-3" id="landMark" name="landMark" required>
           </div>
           <div class="form-group col-md-4">
               <label for="state">State:</label>
               <input type="text" class="form-control border-3" id="state" name="state" required>
           </div>
           <div class="form-group col-md-4">
               <label for="pincode">Pincode:</label>
               <input type="number" class="form-control border-3" id="pincode" name="pincode" required>
           </div>
       </div>
       <div class="row mb-3">
           <div class="form-group col-md-4">
               <label for="phone">Phone:</label>
               <input type="number" class="form-control border-3" id="phone" name="phone" required>
           </div>
           <div class="form-group col-md-4">
               <label for="altPhone">Alternate Phone:</label>
               <input type="number" class="form-control border-3" id="altPhone" name="altPhone" required>
           </div>
       </div>
       <button type="submit" id="submitButton" class="btn btn-primary">Submit</button>
   </form>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  
  document.getElementById('addressForm').addEventListener('submit', function(event) {
    if (!validateForm()) {
        event.preventDefault();
    }
});

function validateForm() {
    let isValid = true;
    const requiredFields = ["addressType", "name", "city", "landMark", "state", "pincode", "phone", "altPhone"];
    const namePattern = /^[A-Za-z\s]{2,}$/;
    const pincodePattern = /^[1-9][0-9]{5}$/;
    const phonePattern = /^\d{10}$/;
    const repeatedDigitsPattern = /^(\d)\1{9}$/;

    // Clear previous error messages
    const errorElements = document.querySelectorAll('.text-danger');
    errorElements.forEach(el => el.remove());

    // Validate required fields
    requiredFields.forEach(function(field) {
        const input = document.getElementById(field);
        const inputValue = input.value.trim();
        const errorDiv = document.createElement('div');
        errorDiv.className = 'text-danger';
        errorDiv.style.fontSize = '12px';
        errorDiv.style.marginTop = '5px';

        if (inputValue === "") {
            errorDiv.textContent = `${input.previousElementSibling.textContent.replace(':', '')} is required.`;
            input.parentNode.appendChild(errorDiv);
            isValid = false;
        }
    });

    // Additional validations for specific fields
    const name = document.getElementById('name').value.trim();
    const city = document.getElementById('city').value.trim();
    const landMark = document.getElementById('landMark').value.trim();
    const state = document.getElementById('state').value.trim();
    const pincode = document.getElementById('pincode').value.trim();
    const phone = document.getElementById('phone').value.trim();
    const altPhone = document.getElementById('altPhone').value.trim();

    // Name validation
    if (name && !namePattern.test(name)) {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'text-danger';
        errorDiv.style.fontSize = '12px';
        errorDiv.style.marginTop = '5px';
        errorDiv.textContent = 'Name must contain at least 2 letters and only alphabets.';
        document.getElementById('name').parentNode.appendChild(errorDiv);
        isValid = false;
    }

    // City validation
    if (city && !namePattern.test(city)) {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'text-danger';
        errorDiv.style.fontSize = '12px';
        errorDiv.style.marginTop = '5px';
        errorDiv.textContent = 'City must contain at least 2 letters and only alphabets.';
        document.getElementById('city').parentNode.appendChild(errorDiv);
        isValid = false;
    }

    // Landmark validation
    if (landMark && !namePattern.test(landMark)) {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'text-danger';
        errorDiv.style.fontSize = '12px';
        errorDiv.style.marginTop = '5px';
        errorDiv.textContent = 'Landmark must contain at least 2 letters and only alphabets.';
        document.getElementById('landMark').parentNode.appendChild(errorDiv);
        isValid = false;
    }

    // State validation
    if (state && !namePattern.test(state)) {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'text-danger';
        errorDiv.style.fontSize = '12px';
        errorDiv.style.marginTop = '5px';
        errorDiv.textContent = 'State must contain at least 2 letters and only alphabets.';
        document.getElementById('state').parentNode.appendChild(errorDiv);
        isValid = false;
    }

    // Pincode validation
    if (pincode && !pincodePattern.test(pincode)) {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'text-danger';
        errorDiv.style.fontSize = '12px';
        errorDiv.style.marginTop = '5px';
        errorDiv.textContent = 'Pincode must be a valid 6-digit number starting from 1-9.';
        document.getElementById('pincode').parentNode.appendChild(errorDiv);
        isValid = false;
    }

    // Phone validation
    if (phone && (!phonePattern.test(phone) || repeatedDigitsPattern.test(phone))) {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'text-danger';
        errorDiv.style.fontSize = '12px';
        errorDiv.style.marginTop = '5px';
        errorDiv.textContent = 'Phone number must be a valid 10-digit number and not all repeated digits.';
        document.getElementById('phone').parentNode.appendChild(errorDiv);
        isValid = false;
    }

    // Alternate Phone validation
    if (altPhone && (!phonePattern.test(altPhone) || repeatedDigitsPattern.test(altPhone))) {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'text-danger';
        errorDiv.style.fontSize = '12px';
        errorDiv.style.marginTop = '5px';
        errorDiv.textContent = 'Alternate phone number must be a valid 10-digit number and not all repeated digits.';
        document.getElementById('altPhone').parentNode.appendChild(errorDiv);
        isValid = false;
    }

    // Check if phone and alternate phone are different
    if (phone && altPhone && phone === altPhone) {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'text-danger';
        errorDiv.style.fontSize = '12px';
        errorDiv.style.marginTop = '5px';
        errorDiv.textContent = 'Phone number and alternate phone number must be different.';
        document.getElementById('altPhone').parentNode.appendChild(errorDiv);
        isValid = false;
    }

    return isValid;
}
</script>
<%- include("../../views/partials/user/footer") %>
