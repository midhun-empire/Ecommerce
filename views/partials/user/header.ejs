<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

	<meta name="author" content="Untree.co">
	<link rel=" icon" href="/public/">

	<meta name="description" content="" />
	<meta name="keywords" content="bootstrap, bootstrap4" />

	<!-- Bootstrap CSS -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
	<link href="/css/tiny-slider.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

	<!-- SweetAlert2 CDN -->
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<title>Brighton</title>
	<style>
		.product-item {
			position: relative;
			display: block;
			overflow: hidden;
			text-align: center;
			transition: all 0.3s ease;
		}

		.product-thumbnail {
			transition: transform 0.3s ease;
		}

		.product-item:hover .product-thumbnail {
			transform: scale(1.05);
		}
		.dropdown-menu {
    display: none;
    position: absolute;
    background-color: white;
    min-width: 160px;
    box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
    z-index: 1000;
    right: 0;
}

.dropdown:hover .dropdown-menu {
    display: block;
}

/* Make sure dropdown items are visible */
.dropdown-item {
    color: white;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
    width: 100%;
}

.dropdown-item:hover {
    background-color:black;
	color: white;
}

/* Fix navbar collapse behavior */
.navbar-collapse {
    justify-content: flex-end;
}

.dropdown-menu {
    background-color: #343a40; /* Dark gray, same as navbar-dark bg-dark */
    border: none;
}


	</style>
</head>

<body>

	<!-- Start Header/Navigation -->
	<nav class="custom-navbar navbar navbar-expand-md navbar-dark bg-dark fixed-top" aria-label="Furni navigation bar">
		<div class="container">
			<a class="navbar-brand" href="/">Brighton<span>.</span></a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarsFurni"
				aria-controls="navbarsFurni" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse" id="navbarsFurni">
				<ul class="custom-navbar-nav navbar-nav me-auto mb-2 mb-md-0 mx-auto">
					<li class="nav-item <%= currentPage === 'home' ? 'active' : '' %>">
						<a class="nav-link" href="/">Home</a>
					</li>
					<li class="nav-item <%= currentPage === 'shop' ? 'active' : '' %>">
						<a class="nav-link" href="/shop">Shop</a>
					</li>
					<li class="nav-item <%= currentPage === 'about' ? 'active' : '' %>">
						<a class="nav-link" href="/about">About</a>
					</li>
					<li class="nav-item <%= currentPage === 'contact' ? 'active' : '' %>">
						<a class="nav-link" href="/contact">Contact</a>
					</li>
				</ul>
			
				<ul class="navbar-nav d-flex flex-row gap-3">
					<% if (locals.user) { %>  <!-- Check if the user is logged in -->
						<!-- User Dropdown -->
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" role="button"
								data-bs-toggle="dropdown" aria-expanded="false">
								<%= locals.user.name %>  <!-- Show the user's name -->
							</a>
							<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
								<li><a class="dropdown-item" href="/userProfile">Profile</a></li>
								<li><a class="dropdown-item" href="/logout"  onclick="softLogout()">Logout</a></li>
							</ul>
						</li>
					<% } else { %>
						<li class="nav-item">
							<a class="nav-link text-white" href="/signup">Sign Up</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-white" href="/login">Login</a>
						</li>
					<% } %>
				</ul>
			
				<!-- Profile, Cart, Wishlist Icons -->
				<ul class="custom-navbar-cta navbar-nav mb-2 mb-md-0 ms-5">
					<li class="nav-item <%= currentPage === 'profile' ? 'active' : '' %>">
						<a class="nav-link" href="/profile">
							<img src="/images/user.svg" alt="Profile" style="width: 24px; height: 24px;">
						</a>
					</li>
					<li class="nav-item <%= currentPage === 'cart' ? 'active' : '' %>">
						<a class="nav-link" href="/cart">
							<img src="/images/cart.svg" alt="Cart">
						</a>
					</li>
					<li class="nav-item mt-3 ms-3 <%= currentPage === 'wishlist' ? 'active' : '' %>">
						<a class="nav-link d-flex align-items-center justify-content-center" href="/wishlist">
							<i class="fa-regular fa-heart fa-xl" style="font-weight: 300; color: #ffffff;"></i>
						</a>
					</li>
				</ul>
			</div>
			
	</nav>

	<!-- Bootstrap JS & Popper -->
	<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

	<script>
		function softLogout() {
    fetch('/logout')
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert("Successfully Logged Out!.");
            }
        });
}
	</script>

</body>
</html>
